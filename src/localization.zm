pub fn weekday_name(index: i64) -> string:
    let weekdays = ["一", "二", "三", "四", "五", "六", "日"]
    weekdays[index]

pub fn event_name(index: i64) -> string:
    let events = ["硬扛", "轮指", "刷准", "首通", "看转播", "打飙速", "乱糊", "采音", "特效", "拜谢", "敲代码", "发情"]
    events[index]

