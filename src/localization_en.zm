pub fn weekday_name(index: i64) -> string:
    let weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    weekdays[index]

pub fn event_name(index: i64) -> string:
    let events = ["Indexing", "Rolling", "Break ACC Record", "World First Clear", "Watch a stream", "Play speed trial", "Play casually", "Charting", "VFXing", "BAIXIE", "Code", "Go wild"]
    events[index]

pub fn api_connection_error(error: &string) -> string:
    f"Daily level: API connection failed ({error})"

pub fn api_request_error(status: i64) -> string:
    f"Daily level: API request failed (HTTP {status})"

pub fn api_json_error(error: &string) -> string:
    f"Daily level: could not parse level list JSON ({error})"

