    f"Daily level: could not parse level JSON ({error})"

pub fn level_description(artist: &string, song: &string, id: &string, author: &string, difficulty: &string, score: &string, clears: &string) -> string:
    f"Daily level: {artist} - {song}\nLevel ID: {id}\nCreator: {author}\nDifficulty: {difficulty} (base score: {score})\nUnique clears: {clears}"

pub fn author_with_vfx(author: &string, vfx: &string) -> string:
    f"{author} / VFX: {vfx}"

pub fn calendar_record(date: &string, fortune: &string, suitable: &string, unsuitable: &string, level_id: i64, level_text: &string) -> string:
    f"Date: {date}\n{fortune}\n{suitable}\n{unsuitable}\n{daily_level_id_record_label()}: {level_id}\n{daily_level_record_label()}: {level_text}\nVersion: {localization.version()}"

pub fn about_summary(date: &string, fortune: &string, suitable: &string, unsuitable: &string, level_id: i64) -> string:
    f"{date}\n{fortune}  |  {suitable}  |  {unsuitable}\n{daily_level_id_record_label()}: {level_id}"
